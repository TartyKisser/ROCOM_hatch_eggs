@import "./generated/font.wxss";

page {
  min-height: 100%;
  background: #f5f0e6;
  color: #282522;
  font-family: "Roco Kingdom Sans", -apple-system, "PingFang SC", sans-serif;
  font-size: 28rpx;
}

view, text, image, button, input, picker, scroll-view { box-sizing: border-box; }

.shell { max-width: 920rpx; margin: 0 auto; padding: 0 26rpx 48rpx; }
.panel {
  background: #fffaf1;
  border: 1px solid #e1d2ba;
  border-radius: 25rpx;
  box-shadow: 0 6rpx 0 #e6d8c2;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  padding: 0 20rpx;
  min-height: 58rpx;
  background: #ede4d5;
  color: #282522;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.25;
  white-space: nowrap;
}

.button::after { border: 0; }
.button[disabled] { opacity: .46; }
.button-dark { background: #272624; color: #fff6e6; }
.button-selected { background: #ffca63; color: #282522; }
.pressed { opacity: .72; }
.badge-row { display: flex; flex-wrap: wrap; gap: 7rpx; }
.tag {
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
  border-radius: 10rpx;
  padding: 5rpx 9rpx;
  background: #eee3d0;
  color: #55493b;
  font-size: 20rpx;
  line-height: 1.25;
  white-space: nowrap;
}

.type-icon { width: 30rpx; height: 30rpx; flex: 0 0 30rpx; }
.tag .type-icon { width: 27rpx; height: 27rpx; flex-basis: 27rpx; }
.muted { color: #695e52; font-size: 24rpx; line-height: 1.65; }
.empty-state { padding: 34rpx 22rpx; text-align: center; }
