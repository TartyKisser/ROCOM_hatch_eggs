<view class="landing-hero">
  <image class="landing-cover" src="{{wallpaper}}" mode="aspectFill" webp="{{true}}" />
  <view class="landing-shade" />
  <view class="shell landing-copy">
    <view class="wordmark"><image src="{{logo}}" mode="aspectFit" aria-label="洛克王国" /></view>
    <text class="landing-title">世界工具站</text>
    <text class="landing-note">查精灵、配对孵蛋、规划家园。</text>
  </view>
</view>

<view class="shell tool landing">
  <view class="panel merchant-panel">
    <view class="merchant-banner">
      <image class="merchant-cover" src="{{merchantCover}}" mode="aspectFill" webp="{{true}}" />
      <view class="merchant-shade" />
      <view class="merchant-heading">
        <view class="merchant-title">
          <text class="tool-title">远行商人</text>
          <text wx:if="{{hours}}" class="merchant-hours">{{hours}}</text>
        </view>
        <button class="button merchant-refresh" hover-class="pressed" bindtap="refreshMerchant" disabled="{{loading}}">刷新</button>
      </view>
    </view>
    <view class="merchant-body">
      <text wx:if="{{merchantNote}}" class="tool-note">{{merchantNote}}</text>
      <scroll-view wx:if="{{shop.length}}" scroll-y="{{true}}" class="merchant-list" style="height: {{shop.length > 4 ? 328 : shop.length * 80}}rpx">
        <view wx:for="{{shop}}" wx:key="id" class="tool-row shop-row" data-index="{{index}}" bindtap="showProduct">
          <image wx:if="{{item.icon}}" class="tool-icon shop-icon" src="{{item.icon}}" mode="aspectFit" lazy-load="{{true}}"
            data-index="{{index}}" data-id="{{item.id}}" binderror="onShopImageError" />
          <view wx:else class="tool-icon shop-icon" />
          <view class="tool-row-copy"><text class="tool-row-name">{{item.name}}</text><text class="tool-meta">{{item.summary}}</text></view>
          <view class="price"><image src="{{coin}}" mode="aspectFit" /><text>{{item.price}}</text></view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="panel tool-section">
    <text class="tool-title">工具导航</text>
    <view class="tool-actions group-tabs">
      <button wx:for="{{groups}}" wx:key="key" class="button {{group === item.key ? 'button-selected' : ''}}" aria-pressed="{{group === item.key}}" hover-class="pressed" data-group="{{item.key}}" bindtap="selectGroup">{{item.label}}</button>
    </view>
    <view class="tool-grid">
      <view wx:for="{{tools}}" wx:key="id" class="tool-tile tool-tile-{{item.group}}" aria-role="button" hover-class="pressed" data-url="{{item.url}}" bindtap="openTool">
        <image src="{{item.image}}" mode="aspectFit" />
        <view class="tool-row-copy"><text class="tool-row-name">{{item.title}}</text><text class="tool-note">{{item.note}}</text></view>
      </view>
    </view>
  </view>
</view>
