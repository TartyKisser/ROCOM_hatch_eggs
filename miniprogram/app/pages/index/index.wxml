<view class="hero">
  <image class="hero-cover" src="{{wallpaper}}" mode="aspectFill" webp="{{true}}" />
  <view class="hero-shade" />
  <view class="shell hero-inner">
    <image class="hero-logo" src="{{logo}}" mode="aspectFit" aria-label="洛克王国" />
    <text class="hero-title">精灵图鉴</text>
  </view>
</view>

<view class="shell catalogue">
  <view class="panel filters">
    <view class="search-row">
      <input class="search" aria-label="搜索精灵" placeholder="搜索编号、名称或分布"
        value="{{filters.query}}" bindinput="onSearch" confirm-type="search" />
      <button class="button button-dark" hover-class="pressed" disabled="{{!isFiltered}}" bindtap="clearFilters">清空</button>
    </view>

    <view class="filter-controls">
      <button class="button filter-control {{filters.attribute || showTypes ? 'filter-active' : ''}}" hover-class="pressed"
        aria-label="系别 {{selectedType.label}}" aria-expanded="{{showTypes}}" bindtap="toggleTypes">
        <text class="filter-label">系别</text>
        <view class="filter-value">
          <image wx:if="{{selectedType.icon}}" class="filter-icon" src="{{selectedType.icon}}" mode="aspectFit" />
          <text>{{selectedType.label}}</text>
        </view>
        <view class="filter-arrow {{showTypes ? 'filter-arrow-up' : ''}}" />
      </button>
      <picker class="filter-picker" mode="selector" range="{{eggOptions}}" value="{{eggIndex}}" bindchange="onEggGroupChange"
        aria-label="蛋组 {{eggOptions[eggIndex]}}">
        <view class="filter-control {{filters.eggGroup ? 'filter-active' : ''}}">
          <text class="filter-label">蛋组</text><view class="filter-value"><text>{{eggOptions[eggIndex]}}</text></view>
          <view class="filter-arrow" />
        </view>
      </picker>
      <picker class="filter-picker" mode="selector" range="{{rareOptions}}" range-key="label" value="{{rareIndex}}" bindchange="onRareChange"
        aria-label="异色 {{rareOptions[rareIndex].label}}">
        <view class="filter-control {{filters.rare ? 'filter-active' : ''}}">
          <text class="filter-label">异色</text><view class="filter-value"><text>{{rareOptions[rareIndex].label}}</text></view>
          <view class="filter-arrow" />
        </view>
      </picker>
    </view>

    <view wx:if="{{showTypes}}" class="type-grid">
      <button wx:for="{{typeOptions}}" wx:key="value" class="button type-choice {{filters.attribute === item.value ? 'button-selected' : ''}}"
        hover-class="pressed" data-value="{{item.value}}" bindtap="onTypeChange">
        <image wx:if="{{item.icon}}" class="filter-icon" src="{{item.icon}}" mode="aspectFit" />
        <text>{{item.label}}</text>
      </button>
    </view>
  </view>

  <view class="results-heading">
    <text class="results-title">精灵列表</text>
    <text class="result-count">{{matching}} / {{count}} 只</text>
  </view>
  <view wx:if="{{syncNote}}" class="muted sync-note">{{syncNote}}，可下拉更新。</view>

  <view wx:if="{{cards.length}}" class="dex-grid">
    <view wx:for="{{cards}}" wx:for-item="card" wx:key="id" class="panel dex-card"
      hover-class="card-pressed" data-id="{{card.id}}" bindtap="openRecord" aria-role="button" aria-label="No. {{card.number}} {{card.title}}">
      <view class="card-stage" style="background: {{card.background}}">
        <text class="card-number">No. {{card.number}}</text>
        <image wx:if="{{card.rare}}" src="{{rareIcon}}" class="card-shiny" mode="aspectFit" aria-label="有异色" />
        <image wx:if="{{card.thumb}}" class="card-portrait" src="{{card.thumb}}" mode="aspectFit" lazy-load="{{true}}"
          data-index="{{index}}" data-id="{{card.id}}" data-src="{{card.thumb}}" binderror="onThumbError" />
        <text wx:else class="muted">暂无立绘</text>
      </view>
      <view class="card-copy">
        <text class="card-title">{{card.title}}</text>
        <view class="badge-row">
          <view wx:for="{{card.types}}" wx:for-item="type" wx:key="label" class="tag">
            <image wx:if="{{type.icon}}" class="type-icon" src="{{type.icon}}" mode="aspectFit" />
            <text>{{type.label}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view wx:else class="panel empty-state muted">没有符合条件的精灵。</view>
  <button wx:if="{{hasMore}}" class="button load-more" hover-class="pressed" bindtap="onReachBottom">显示更多</button>
</view>
