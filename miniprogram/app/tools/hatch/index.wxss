@import "../../ui/tools.wxss";

.nest-slot { border-top: 1px solid #eadbc6; padding-top: 8rpx; }
.slot-line { display: flex; align-items: center; gap: 7rpx; }
.slot-name { min-height: 36px; justify-content: center; }
button.sex { min-height: 34px; padding: 0 12rpx; }
.nest-choose { display: flex; flex-direction: column; gap: 6rpx; margin-top: 7rpx; }
.nest-suggestions { width: 100%; }
.nest-option { height: 72rpx; }
.nest-option .tool-icon { width: 50rpx; height: 50rpx; flex-basis: 50rpx; }
.nest-board-scroll { width: 100%; }
.nest-board { position: relative; margin: 0 auto; background-color: #f6ecd9; background-image: linear-gradient(90deg, #e9d9bd 1px, transparent 1px), linear-gradient(#e9d9bd 1px, transparent 1px); }
.nest { position: absolute; border: 1px solid; border-radius: 8rpx; padding: 5rpx; }
.nest image { width: 100%; height: 100%; }
.nest text { position: absolute; left: 4rpx; top: 3rpx; font-size: 21rpx; }
.nest-male { background: #d5e6f5; border-color: #8cb8e1; }
.nest-female { background: #f9d9e7; border-color: #e6a9c7; }
