@import "../../ui/tools.wxss";

button.map-small-button { min-height: 33px; padding: 0 11rpx; }
.map-results { padding: 9rpx 12rpx; background: #f3e8d7; border-radius: 10rpx; }
.map-result image, .map-detail-meta image, .map-detail-row image { width: 50rpx; height: 50rpx; flex: 0 0 50rpx; }
.map-panel { margin-bottom: 15rpx; border-radius: 16rpx; overflow: hidden; }
.map-surface { position: relative; }
.world-canvas { display: block; width: 100%; height: max(310px, 710rpx); background: #d7c8ae; }
.canvas-actions { position: absolute; top: 8rpx; right: 8rpx; display: flex; flex-direction: column; gap: 6rpx; }
.canvas-actions button { width: max(36px, 70rpx); min-height: max(36px, 68rpx); padding: 0; border-radius: 8rpx; background: #fffaeeed; }
.map-alert { position: absolute; left: 28rpx; right: 87rpx; top: 35%; display: flex; flex-direction: column; align-items: center; gap: 7rpx; padding: 12rpx; background: #fffaf1; border-radius: 10rpx; }
.map-status { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 5rpx 12rpx; padding: 8rpx 10rpx; font-size: max(11px, 20rpx); }
.map-detail-meta { padding: 0; }
.map-detail-actions button { min-height: 33px; padding: 0 8rpx; }
.map-detail-group { background: #f3e7d5; padding: 9rpx; border-radius: 8rpx; }
.map-collection switch { transform: scale(.8); transform-origin: right center; }
.map-group { border-top: 1px solid #e9d9bf; }
.map-group-title { min-height: 35px; }
.map-categories button, .map-presets button { flex: 0 0 auto; min-height: 32px; padding: 0 9rpx; }
.map-categories image { width: 29rpx; height: 29rpx; }
