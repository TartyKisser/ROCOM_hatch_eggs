.detail { padding-top: 22rpx; }
.return-button { margin-bottom: 17rpx; }
.profile { overflow: hidden; }
.portrait-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 414rpx;
  border-bottom: 1px solid #e1d2ba;
  padding: 12rpx 24rpx 45rpx;
}
.portrait { width: 100%; height: 100%; }
.shiny-toggle { position: absolute; bottom: 16rpx; left: 17rpx; min-height: 55rpx; }
.profile-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 12rpx; padding: 25rpx; }
.profile-number { color: #8a632b; font-size: 24rpx; }
.profile-title { font-size: 49rpx; font-weight: 700; line-height: 1.12; overflow-wrap: anywhere; }
.facts { display: flex; flex-wrap: wrap; gap: 9rpx 22rpx; font-size: 23rpx; line-height: 1.6; }
.fact-label { margin-right: 5rpx; color: #695e52; }
.prose { display: block; color: #5b5044; font-size: 26rpx; line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; }
.measurements { display: flex; align-self: stretch; gap: 8rpx; }
.measure {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: space-between;
  gap: 7rpx;
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  background: #ede4d5;
  font-size: 24rpx;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.measure text:first-child { color: #695e52; font-size: 21rpx; }
.values { display: flex; flex-wrap: wrap; gap: 8rpx 19rpx; color: #695e52; font-size: 21rpx; }
.values view { display: flex; align-items: center; gap: 7rpx; }
.values image { width: 31rpx; height: 31rpx; }
.values text { color: #282522; font-size: 23rpx; }
.detail-tabs { display: flex; gap: 6rpx; padding: 6rpx; margin: 25rpx 0 13rpx; border-radius: 999rpx; background: #272624; }
.detail-tabs .button { flex: 1; min-width: 0; min-height: 63rpx; }
.sections { display: flex; flex-direction: column; gap: 16rpx; }
.section { display: flex; flex-direction: column; gap: 14rpx; padding: 21rpx; }
.section-title { display: block; font-size: 33rpx; font-weight: 700; line-height: 1.24; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.section-divider { height: 1px; background: #e7dac6; }
.choices { display: flex; flex-wrap: wrap; gap: 8rpx; }
.choices .button { min-height: 51rpx; }
.item-preview { display: flex; align-items: center; justify-content: center; min-height: 183rpx; border: 1px solid #eee2ce; border-radius: 15rpx; background: #f4ebdc; }
.item-preview image { width: 156rpx; height: 156rpx; }
.evolution-scroll { width: 100%; }
.evolution { display: inline-flex; align-items: center; padding: 2rpx 0 6rpx; gap: 8rpx; }
.evolution-card { display: flex; flex: 0 0 154rpx; flex-direction: column; align-items: center; justify-content: flex-start; align-self: stretch; gap: 5rpx; border: 1px solid #eadbc4; border-radius: 14rpx; padding: 7rpx; text-align: center; font-size: 21rpx; line-height: 1.3; }
.evolution-card.current-stage { border-color: #c28f42; }
.evolution-card image { width: 116rpx; height: 100rpx; }
.stage-number { color: #695e52; font-size: 17rpx; }
.evolution-arrow { color: #966f33; }
.subheading { display: block; font-size: 26rpx; font-weight: 700; }
.stats { display: flex; flex-direction: column; gap: 10rpx; }
.stat { display: grid; grid-template-columns: 59rpx 1fr 45rpx; align-items: center; gap: 12rpx; font-size: 23rpx; }
.stat text:last-child { text-align: right; }
.stat-track, .stat-fill { height: 11rpx; border-radius: 999rpx; }
.stat-track { overflow: hidden; background: #ece3d3; }
.ability { display: flex; flex-direction: column; gap: 5rpx; padding: 13rpx 16rpx; border-radius: 14rpx; background: #f3ebdf; }
.skill-card { display: flex; gap: 13rpx; padding: 14rpx; border: 1px solid #e9ddca; border-radius: 15rpx; background: #f4ecdf; }
.skill-icon { width: 64rpx; height: 64rpx; flex: 0 0 64rpx; border-radius: 12rpx; background: #ecdfc9; }
.skill-info { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; }
.skill-heading { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8rpx; font-size: 28rpx; }
.skill-secondary { color: #815a2d; font-size: 22rpx; }
.research-progress { border-radius: 12rpx; padding: 6rpx 10rpx; background: #f5e4bb; color: #6e4b1c; font-size: 22rpx; }
.research-task { display: flex; align-items: baseline; gap: 12rpx; line-height: 1.55; font-size: 26rpx; }
.research-number { min-width: 24rpx; color: #8a632b; }
.source-button { display: flex; margin: 23rpx auto 0; font-size: 22rpx; }
