.detail { padding-top: 13rpx; }
.profile {
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
  padding: 13rpx;
}
.profile-compact { grid-template-columns: 88rpx minmax(0, 1fr); padding: 10rpx 13rpx; }
.portrait-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 180rpx;
  border-radius: 15rpx;
  padding: 6rpx;
  text-align: center;
}
.portrait { width: 100%; height: 100%; }
.profile-compact .portrait-stage { height: 88rpx; }
.profile-copy { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; gap: 5rpx; }
.profile-number { color: #8a632b; font-size: max(11px, 22rpx); }
.profile-title { font-size: max(18px, 36rpx); font-weight: 700; line-height: 1.2; overflow-wrap: anywhere; }
.profile-compact .profile-title { font-size: max(16px, 31rpx); }
.profile-badges, .facts { display: flex; flex-wrap: wrap; align-items: center; gap: 6rpx 12rpx; }
button.shiny-toggle { min-height: max(32px, 56rpx); gap: 5rpx; padding: 0 10rpx; border-radius: 10rpx; }
.shiny-toggle .type-icon { width: 24rpx; height: 24rpx; flex-basis: 24rpx; }
.facts { font-size: max(12px, 22rpx); line-height: 1.45; overflow-wrap: anywhere; }
.fact-label { margin-right: 4rpx; color: #75654f; }
.detail-tabs {
  position: sticky;
  top: 0;
  z-index: 2;
  display: flex;
  gap: 6rpx;
  padding: 4rpx;
  margin: 12rpx 0;
  border-radius: 14rpx;
  background: #272624;
}
.detail-tabs button { flex: 1; min-height: max(38px, 68rpx); border-radius: 11rpx; }
.sections { display: flex; flex-direction: column; gap: 11rpx; }
.section { display: flex; min-width: 0; flex-direction: column; gap: 10rpx; padding: 14rpx; border-radius: 19rpx; }
.section-title { display: block; font-size: max(16px, 31rpx); font-weight: 700; line-height: 1.25; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.section-meta { border-radius: 8rpx; padding: 4rpx 8rpx; background: #f5e4bb; color: #6e4b1c; font-size: max(11px, 21rpx); }
.section-divider { height: 1px; background: #e7dac6; }
.prose { display: block; color: #5b5044; font-size: max(14px, 26rpx); line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; }
.subheading { display: block; font-size: max(13px, 25rpx); font-weight: 700; }
.stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8rpx 16rpx; }
.stat { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 6rpx; font-size: max(12px, 23rpx); }
.stat-value { min-width: 42rpx; text-align: right; }
.stat-track, .stat-fill { height: 8rpx; border-radius: 999rpx; }
.stat-track { overflow: hidden; background: #ece3d3; }
.measurements { display: flex; gap: 7rpx; }
.measure {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 3rpx;
  padding: 6rpx 8rpx;
  border-radius: 8rpx;
  background: #eee5d7;
  font-size: max(12px, 23rpx);
  line-height: 1.3;
  overflow-wrap: anywhere;
}
.measure text:first-child { color: #75654f; font-size: max(11px, 21rpx); }
.values { display: flex; flex-wrap: wrap; gap: 5rpx 16rpx; color: #75654f; font-size: max(11px, 21rpx); }
.values view { display: flex; min-width: 0; align-items: center; gap: 5rpx; }
.values image { width: 25rpx; height: 25rpx; flex: none; }
.values text { color: #282522; }
.item-layout { display: grid; grid-template-columns: minmax(0, 1fr) 148rpx; align-items: stretch; gap: 12rpx; }
.item-options { display: flex; min-width: 0; flex-direction: column; justify-content: center; gap: 7rpx; }
.choices { display: flex; flex-wrap: wrap; gap: 7rpx; }
.choices button { flex: 1 0 auto; min-height: max(33px, 58rpx); padding: 0 8rpx; border-radius: 10rpx; }
.item-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 128rpx;
  padding: 5rpx;
  border: 1px solid #ebdec8;
  border-radius: 12rpx;
  background: #f4ebdc;
  color: #75654f;
  font-size: max(11px, 21rpx);
  text-align: center;
}
.item-preview image { width: 106rpx; height: 106rpx; }
.evolution-scroll { width: 100%; }
.evolution { display: inline-flex; align-items: center; padding: 2rpx 0 5rpx; gap: 7rpx; }
.evolution-card { display: flex; width: 136rpx; flex: 0 0 136rpx; flex-direction: column; align-items: center; align-self: stretch; gap: 3rpx; border: 1px solid #eadbc4; border-radius: 10rpx; padding: 5rpx; text-align: center; font-size: max(11px, 21rpx); line-height: 1.25; overflow-wrap: anywhere; }
.evolution-card.current-stage { border-color: #c28f42; }
.evolution-card image, .stage-placeholder { width: 92rpx; height: 67rpx; }
.stage-number { color: #695e52; font-size: max(10px, 17rpx); }
.evolution-arrow { color: #966f33; }
.ability { display: flex; flex-direction: column; gap: 4rpx; padding: 8rpx 10rpx; border-radius: 10rpx; background: #f3ebdf; }
.skill-filters { margin: 0 0 3rpx; }
.skill-row { display: flex; flex-direction: column; gap: 4rpx; padding: 9rpx 1rpx; border-top: 1px solid #e7dac6; }
.skill-row:last-child { padding-bottom: 1rpx; }
.skill-heading { display: flex; align-items: center; gap: 7rpx; font-size: max(14px, 27rpx); }
.skill-icon { width: 40rpx; height: 40rpx; flex: 0 0 40rpx; border-radius: 7rpx; background: #f0e6d6; }
.skill-name { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.skill-secondary { color: #815a2d; font-size: max(11px, 21rpx); }
.skill-meta { line-height: 1.4; }
.research-task { display: flex; align-items: baseline; gap: 9rpx; padding: 9rpx 1rpx; border-top: 1px solid #e7dac6; line-height: 1.5; font-size: max(14px, 26rpx); }
.research-task:last-child { padding-bottom: 1rpx; }
.research-number { flex: 0 0 31rpx; color: #8a632b; font-size: max(12px, 23rpx); }
.research-text { min-width: 0; overflow-wrap: anywhere; }
button.source-button { display: flex; width: fit-content; margin: 14rpx auto 0; border-radius: 11rpx; }
