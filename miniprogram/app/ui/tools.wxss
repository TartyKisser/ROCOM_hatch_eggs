.tool { padding-top: 18rpx; }
.tool-section { display: flex; flex-direction: column; gap: 12rpx; padding: 16rpx; margin-bottom: 13rpx; border-radius: 18rpx; }
.tool-heading { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.tool-title { font-size: max(16px, 33rpx); font-weight: 700; line-height: 1.28; }
.tool-subtitle { font-size: max(14px, 27rpx); line-height: 1.3; }
.tool-note { color: #695e52; font-size: max(12px, 23rpx); line-height: 1.5; overflow-wrap: anywhere; }
.tool-prose { color: #55483d; font-size: max(14px, 25rpx); line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; }
.tool-error { color: #9e402e; }
.tool-field { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 6rpx; font-size: max(12px, 23rpx); }
.field-row, .tool-actions { display: flex; align-items: center; gap: 8rpx; }
.tool-actions { flex-wrap: wrap; }
.tool-actions button { flex: 1 0 auto; border-radius: 10rpx; }
.tool input {
  width: 100%; min-width: 0; min-height: 36px; padding: 0 13rpx; border: 1px solid #e2d3bc; border-radius: 10rpx;
  background: #f3eadb; color: #282522; font-family: inherit; font-size: max(14px, 25rpx); line-height: 1.35;
}
.tool-row { display: flex; gap: 10rpx; align-items: center; padding: 9rpx 0; border-top: 1px solid #eadbc6; }
.tool-row:first-child { border-top: 0; }
.tool-row-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.tool-icon { width: 70rpx; height: 70rpx; flex: 0 0 70rpx; border-radius: 10rpx; background: #eee4d4; }
.tool-row-name { font-size: max(13px, 26rpx); line-height: 1.35; overflow-wrap: anywhere; }
.tool-meta { color: #805e35; font-size: max(11px, 21rpx); line-height: 1.4; }
.tool-em { color: #84571c; }
.tool-stat { border-radius: 10rpx; background: #f0e6d6; padding: 8rpx 9rpx; display: flex; flex-direction: column; min-width: 0; gap: 4rpx; }
.tool-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; }
.tool-section .tag { white-space: normal; }
.tool-empty { padding: 17rpx 0; text-align: center; }
button.tool-more { display: flex; margin: 10rpx auto 0; }
